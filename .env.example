# Dev: Postgres z docker-compose (port 5433, żeby nie kolidował z lokalnym 5432)
DATABASE_URL="postgresql://li_crm:li_crm_dev@localhost:5433/li_crm?schema=public"
DIRECT_URL="postgresql://li_crm:li_crm_dev@localhost:5433/li_crm?schema=public"

# Prod (Vercel): sslmode=require i niski connection_limit, np.
# DATABASE_URL="postgresql://li_crm:<hasło>@dirwro.ddns.net:54320/li_crm?sslmode=require&connection_limit=3"

# Logowanie (patrz scripts/hash-password.ts): klucz podpisu sesji (min. 32 znaki) i skrót hasła.
# W produkcji bez obu zmiennych aplikacja nic nie serwuje (503). Lokalnie, gdy ich brak, logowanie jest wyłączone.
AUTH_SECRET=""
AUTH_PASSWORD_HASH=""
# Klucze dostępu (Touch ID) są przypięte do domeny. Produkcja: oba ustawione jawnie, bez nich klucze są wyłączone.
# Lokalnie (localhost) nie trzeba ich ustawiać.
# AUTH_RP_ID="li-crm.mydmb.pl"
# AUTH_ORIGIN="https://li-crm.mydmb.pl"
INGEST_API_KEY=""

# Klucz API dla n8n (synchronizacja z Kalendarzem Google), min. 24 znaki; nagłówek x-api-key
SYNC_API_KEY=""
