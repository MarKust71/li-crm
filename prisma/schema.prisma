// li-crm — schemat bazy (v0.2)
// Zastępuje arkusze: "1000  osób LinkedIn", "li-contact-data-store", "li-time".
// Mapowanie kolumn arkuszy → modele: docs/spec.md, sekcja 5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // dla migracji, gdy przed bazą stanie pooler
}

// ───────────────────────── Kontakty ─────────────────────────

enum Direction {
  OUTBOUND // ja zapraszam (zakładka "Ja zapraszam")
  INBOUND  // zaprosili mnie (zakładka "Zaprosili mnie")
}

enum Source {
  SEARCH        // content2.js – wyniki wyszukiwania
  VIEWERS       // content3.js – "Kto oglądał Twój profil"
  PYMK          // content4.js – "People you may know"
  SUGGESTIONS   // content5.js – "Manage invitations – Suggestions for you"
  PROFILE       // content6.js – strona profilu
  MORE_PROFILES // content7.js – "More profiles"
  MANUAL
  IMPORT        // jednorazowa migracja z arkuszy
}

// Bieżący etap lejka. Wyliczany z ostatniego istotnego zdarzenia (ContactEvent),
// przechowywany w Contact dla szybkiego filtrowania.
enum Stage {
  CAPTURED         // zebrany przez rozszerzenie, jeszcze bez zaproszenia
  INVITED
  ACCEPTED
  THANKED          // wysłałem podziękowanie (Appr.-Resp.)
  ASKED_OPEN       // zadałem pytanie "Are you open"
  OPEN_TO_TALK
  NOT_INTERESTED
  BOM_PROPOSED
  BOM_SCHEDULED
  BOM_COMPLETED
  DECISION_YES
  DECISION_NO
}

// "Ignored" z arkusza = wyłącznik rekordu, nie etap lejka.
enum ArchiveReason {
  NO_CONVERSATION   // nie życzy sobie rozmów
  INVITE_REJECTED   // zaproszenie przestało być "pending", osoba znów 2./3. stopnia
  DECISION_MADE     // decyzja podjęta (np. po rozmowie), kontakt zamknięty
  OTHER
}

model Contact {
  id            String         @id @default(cuid())
  profileUrl    String         @unique // znormalizowany, patrz docs/spec.md 6.1
  name          String
  salutation    String?        // wołacz do szablonów wiadomości: "Pani Aniu"
  location      String?
  threadUrl     String?        // wątek rozmowy na LinkedIn (https://www.linkedin.com/messaging/thread/…), dostępny od przyjęcia zaproszenia
  occupation    String?
  email         String?
  phone         String?
  openToWork    Boolean        @default(false) // kolumna "OTW"
  direction     Direction      @default(OUTBOUND)
  source        Source         @default(MANUAL)
  contactFrom   String?        // kolumna "Contact-From"
  stage         Stage          @default(CAPTURED)
  archived      Boolean        @default(false) // kolumna "Ignored"
  archiveReason ArchiveReason?
  archivedAt    DateTime?
  info          String?        // kolumna "Info"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  events   ContactEvent[]
  tags     ContactTag[]
  captures Capture[]
  reminders Reminder[]

  @@index([stage])
  @@index([direction, stage, archived])
}

// ───────────── Poczekalnia: osoby z masowych importów, jeszcze nie kontakty ─────────────
// „People you may know” nie zakłada kontaktów od razu: nowa osoba trafia tu, a użytkownik wybiera, kogo dodać (→ Contact)
// albo odrzucić (REJECTED: wiersz zostaje, żeby kolejne importy jej nie przywracały). Nie ma tu etapu ani zdarzeń.

enum CandidateStatus {
  PENDING  // czeka na decyzję
  REJECTED // odrzucona: ukryta, nie wraca przy kolejnych importach (można przywrócić)
}

model Candidate {
  id          String          @id @default(cuid())
  profileUrl  String          @unique // znormalizowany, jak Contact.profileUrl
  name        String
  occupation  String?
  openToWork  Boolean         @default(false)
  source      Source          @default(PYMK)
  status      CandidateStatus @default(PENDING)
  seenCount   Int             @default(1) // ile razy zebrano ją w importach
  firstSeenAt DateTime        @default(now())
  lastSeenAt  DateTime        @default(now())
  views       CandidateView[]

  @@index([status, lastSeenAt])
}

// Wyświetlenia mojego profilu przez osobę z poczekalni (lista oglądających). Po dodaniu osoby jako kontaktu
// zamieniają się w zdarzenia VIEWED_MY_PROFILE, żeby historia wyświetleń nie ginęła.
model CandidateView {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  viewedAt    DateTime

  @@index([candidateId, viewedAt])
}

// ─────────────── Lejek: zdarzenia zamiast ~40 kolumn ───────────────

enum EventType {
  INVITE_SENT            // Connect (data) + Connect-Msg (treść)  [OUTBOUND]
  INVITE_RECEIVED        // [INBOUND]
  INVITE_WITHDRAWN       // Withdraw: wycofałem zaproszenie po długim oczekiwaniu (może wrócić nowe INVITE_SENT)
  ACCEPTED               // Accept. Delay = Accept − Connect (liczone, nie zapisywane)
  REACTION_RECEIVED      // Appreciation: osoba przy akceptacji zareagowała (emotka, wiadomość)
  THANKS_SENT            // Appr.-Resp. (data) + Appr.-Resp.-Msg (moja wiadomość)
  ASKED_OPEN             // Are-You-Open (data) + A-Y-O-Text
  ASKED_OPEN_REMINDER    // A-Y-O-Reminder + A-Y-O-Reminder-Text
  ASKED_OPEN_RESPONSE    // A-Y-O-Response: data pierwszej reakcji na pytanie; decyzja może być od razu lub później
  OPEN_TO_TALK           // A-Y-O-Decision (data) gdy Open-To-Talk = TRUE
  NOT_INTERESTED         // A-Y-O-Decision (data) gdy NO = TRUE, + NO-Response-Text
  NOT_NOW                // odpowiedź "Nie teraz" na pytanie o rozmowę (nie zamyka kontaktu, przypomnienia zostają)
  BOM_PROPOSED       // Meet-Proposal + Meet-Proposal-Text
  BOM_PROPOSAL_REMINDER // Meet-Proposal-Reminder + -Text
  BOM_SCHEDULED           // BP-Date → scheduledAt
  BOM_CONFIRMED           // Confirmed
  BOM_CANCELED            // BP-Canceled
  BOM_NO_SHOW             // BP-NoShow
  BOM_COMPLETED           // BP-Completed
  DECISION_YES           // Decision-YES
  DECISION_NO            // Decision-NO
  FOLLOW_UP              // FU: spotkanie po odbytym BOM (scheduledAt = termin); nie zmienia etapu, wymaga BOM_COMPLETED
  VIEWED_MY_PROFILE      // Viewed / onViewersList / dane z content3.js
  NOTE
}

model ContactEvent {
  id          String    @id @default(cuid())
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type        EventType
  occurredAt  DateTime
  message     String?   // treść wysłanej / otrzymanej wiadomości
  scheduledAt DateTime? // np. termin BP
  dateUnknown Boolean   @default(false) // true = occurredAt to znacznik (np. 2000-01-01), nie prawdziwa data; pomijać w statystykach czasu
  createdAt   DateTime  @default(now())

  // Synchronizacja z Kalendarzem Google: tylko BOM_SCHEDULED i FOLLOW_UP z terminem (scheduledAt). Patrz lib/calendar-sync*.ts.
  durationMinutes   Int       @default(30)
  googleEventId     String?
  googleCalendarId  String?
  calendarTitle     String?   // tytuł wydarzenia BEZ znacznika odbycia (dla FOLLOW_UP: tytuł dosłownie, ze znacznikiem użytkownika)
  syncState         SyncState @default(SYNCED)
  syncError         String?
  syncAttempts      Int       @default(0)
  calendarUpdatedAt DateTime?
  updatedAt         DateTime  @default(now()) @updatedAt // wersja zmiany dla synchronizacji

  @@unique([googleCalendarId, googleEventId])
  @@index([contactId, occurredAt])
  @@index([type, occurredAt])
  @@index([syncState])
}

// Wydarzenie w kalendarzu do usunięcia po skasowaniu powiązanego zdarzenia historii (wiersz ContactEvent już nie istnieje).
model CalendarTombstone {
  id               String    @id @default(cuid())
  googleEventId    String
  googleCalendarId String
  syncState        SyncState @default(PENDING)
  syncAttempts     Int       @default(0)
  syncError        String?
  createdAt        DateTime  @default(now())

  @@unique([googleCalendarId, googleEventId])
}

// ───────────────────── Tagi (dawne zakładki-segmenty) ─────────────────────

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique // "Częstochowa", "Wrocław (nauczycielki)", "Katowice - reconnect"…
  contacts ContactTag[]
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

// ─────────── Surowe dane z rozszerzenia (dziś: li-contact-data-store) ───────────

model Capture {
  id         String   @id @default(cuid())
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source     Source
  payload    Json     // pojedynczy element "results" z webhooka, bez zmian
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// ───────────────────────── Czas pracy (dziś: li-time) ─────────────────────────

model ActivityType {
  id      String      @id @default(cuid())
  name    String      @unique // "akceptacja", "zaproszenia do kontaktu", "wiadomość", "oglądacze"…
  entries TimeEntry[]
}

model TimeEntry {
  id             String        @id @default(cuid())
  startedAt      DateTime
  endedAt        DateTime?     // null = sesja w toku (przycisk start/stop)
  pausedAt       DateTime?     // null = nie w pauzie; inaczej od kiedy trwa bieżąca pauza (sesja w toku)
  pausedSeconds  Int           @default(0) // suma zakończonych przerw; czas netto = koniec − początek − przerwy
  activityTypeId String?
  activityType   ActivityType? @relation(fields: [activityTypeId], references: [id])
  count          Int?          // "akceptacja (3)" → 3
  note           String?

  @@index([startedAt])
}

// ───────────────────── Przypomnienia ("Dziś do zrobienia") ─────────────────────
// Zastępują dwa workflowy n8n (formularze → wydarzenia w kalendarzu Google "dMb").
// Przypomnienie ustawia się ręcznie (z opóźnieniem) albo powstaje automatycznie (re-connect +3 tygodnie
// po wycofaniu zaproszenia). googleEventId łączy je z wydarzeniem w kalendarzu (synchronizacja przez n8n).

enum ReminderKind {
  REMINDER  // ogólne przypomnienie o kontakcie (treść w note)
  RECONNECT // ponowne zaproszenie: LinkedIn nie pozwala wcześniej niż 3 tygodnie po wycofaniu
}

enum ReminderStatus {
  OPEN
  DONE     // odbyte ("v ", "x ", "- " na początku tytułu w kalendarzu)
  CANCELED // usunięte z listy; zostaje w bazie, żeby n8n mógł skasować wydarzenie w kalendarzu
}

enum SyncState {
  PENDING // zmiana w aplikacji czeka na wysłanie do kalendarza
  SYNCED
  ERROR   // ostatnia próba się nie udała (ponawiana do 5 razy)
}

enum ReminderSource {
  APP    // dodane ręcznie w aplikacji
  AUTO   // utworzone automatycznie (re-connect po wycofaniu zaproszenia)
  IMPORT // zaimportowane z kalendarza Google
}

model Reminder {
  id               String         @id @default(cuid())
  contactId        String
  contact          Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  kind             ReminderKind   @default(REMINDER)
  dueAt            DateTime       // dla wydarzeń całodniowych: północ czasu warszawskiego
  allDay           Boolean        @default(true)
  note             String?        // np. "umówić BP", "AYO?", wątek LinkedIn
  status           ReminderStatus @default(OPEN)
  doneAt           DateTime?
  source           ReminderSource @default(APP)
  googleEventId    String?        // id wydarzenia w kalendarzu Google
  googleCalendarId String?
  calendarTitle    String?        // tytuł wydarzenia BEZ znacznika odbycia ("v ", "x ", "- "); znacznik wynika ze statusu
  syncState        SyncState      @default(SYNCED) // PENDING = zmiana w aplikacji czeka na wysłanie do kalendarza
  syncError        String?
  syncAttempts     Int            @default(0)
  calendarUpdatedAt DateTime?     // pole "updated" wydarzenia przy ostatniej synchronizacji (odfiltrowuje echo własnych zmian)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([googleCalendarId, googleEventId])
  @@index([status, dueAt])
  @@index([contactId])
}

// ───────────────────── Logowanie ─────────────────────
// Ograniczanie prób zgadywania hasła (aplikacja jest publiczna, a funkcje serverless nie współdzielą pamięci,
// więc liczniki muszą być w bazie). Blokada liczona per adres IP i globalnie, patrz lib/auth/throttle.ts.

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}

// Klucze dostępu (passkeys / Touch ID, WebAuthn). Klucz prywatny nigdy nie opuszcza urządzenia: tu jest tylko publiczny.
model Passkey {
  id           String    @id @default(cuid())
  credentialId String    @unique // base64url
  publicKey    Bytes
  counter      BigInt    @default(0) // licznik podpisów (uint32; Apple zwykle zostawia 0)
  transports   String[]
  deviceType   String    // "singleDevice" | "multiDevice" (synchronizowany, np. iCloud Keychain)
  backedUp     Boolean
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
}

// Jednorazowe wyzwania WebAuthn: zużywane przy weryfikacji (replay tej samej odpowiedzi jest odrzucany), ważne 5 minut.
model AuthChallenge {
  id        String   @id @default(cuid())
  challenge String
  purpose   String   // "register" | "login"
  expiresAt DateTime

  @@index([expiresAt])
}

// ───────────────────── Ustawienia aplikacji (klucz → wartość) ─────────────────────
// Klucze (patrz lib/settings.ts): calendarSync.intervalMinutes, calendarSync.lastRunAt, calendarSync.manualRequestedAt,
// calendarSync.pullCursor, calendarSync.lastError.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Wysłane powiadomienia (Telegram przez n8n): klucz zapobiega wysłaniu tej samej wiadomości dwa razy.
// Klucze: digest:<data>, meeting:<id zdarzenia>:<termin>, error:<sygnatura>:<data>, test:<znacznik>.
model SentNotification {
  key    String   @id
  sentAt DateTime @default(now())

  @@index([sentAt])
}

// ───────────────────── Dziennik aktywności (/log) ─────────────────────
// Jeden wspólny log: zmiany użytkownika, synchronizacja, powiadomienia, logowania. Wpisy starsze niż 180 dni usuwa się
// automatycznie (raz na dobę), poza tym ręcznie na stronie /log. contactId bez klucza obcego: wpis przeżywa usunięcie kontaktu.
enum ActivitySource {
  UI
  SYNC
  NOTIFY
  AUTH
  SYSTEM
}

enum ActivityLevel {
  INFO
  WARN
  ERROR
}

model ActivityLog {
  id        String        @id @default(cuid())
  at        DateTime      @default(now())
  source    ActivitySource
  level     ActivityLevel @default(INFO)
  action    String        // kod, np. contact.otw_changed
  contactId String?
  summary   String
  details   Json?

  @@index([at])
  @@index([source, at])
  @@index([contactId, at])
}
