// li-crm — schemat bazy (v0.2)
// Zastępuje arkusze: "1000  osób LinkedIn", "li-contact-data-store", "li-time".
// Mapowanie kolumn arkuszy → modele: docs/spec.md, sekcja 5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // dla migracji, gdy przed bazą stanie pooler
}

// ───────────────────────── Kontakty ─────────────────────────

enum Direction {
  OUTBOUND // ja zapraszam (zakładka "Ja zapraszam")
  INBOUND  // zaprosili mnie (zakładka "Zaprosili mnie")
}

enum Source {
  SEARCH        // content2.js – wyniki wyszukiwania
  VIEWERS       // content3.js – "Kto oglądał Twój profil"
  PYMK          // content4.js – "People you may know"
  SUGGESTIONS   // content5.js – "Manage invitations – Suggestions for you"
  PROFILE       // content6.js – strona profilu
  MORE_PROFILES // content7.js – "More profiles"
  MANUAL
  IMPORT        // jednorazowa migracja z arkuszy
}

// Bieżący etap lejka. Wyliczany z ostatniego istotnego zdarzenia (ContactEvent),
// przechowywany w Contact dla szybkiego filtrowania.
enum Stage {
  CAPTURED         // zebrany przez rozszerzenie, jeszcze bez zaproszenia
  INVITED
  ACCEPTED
  THANKED          // wysłałem podziękowanie (Appr.-Resp.)
  ASKED_OPEN       // zadałem pytanie "Are you open"
  OPEN_TO_TALK
  NOT_INTERESTED
  MEETING_PROPOSED
  BP_SCHEDULED
  BP_COMPLETED
  DECISION_YES
  DECISION_NO
}

// "Ignored" z arkusza = wyłącznik rekordu, nie etap lejka.
enum ArchiveReason {
  NO_CONVERSATION   // nie życzy sobie rozmów
  INVITE_REJECTED   // zaproszenie przestało być "pending", osoba znów 2./3. stopnia
  OTHER
}

model Contact {
  id            String         @id @default(cuid())
  profileUrl    String         @unique // znormalizowany, patrz docs/spec.md 6.1
  name          String
  salutation    String?        // wołacz do szablonów wiadomości: "Pani Aniu"
  location      String?
  occupation    String?
  email         String?
  phone         String?
  openToWork    Boolean        @default(false) // kolumna "OTW"
  direction     Direction      @default(OUTBOUND)
  source        Source         @default(MANUAL)
  contactFrom   String?        // kolumna "Contact-From"
  stage         Stage          @default(CAPTURED)
  archived      Boolean        @default(false) // kolumna "Ignored"
  archiveReason ArchiveReason?
  archivedAt    DateTime?
  info          String?        // kolumna "Info"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  events   ContactEvent[]
  tags     ContactTag[]
  captures Capture[]

  @@index([stage])
  @@index([direction, stage, archived])
}

// ─────────────── Lejek: zdarzenia zamiast ~40 kolumn ───────────────

enum EventType {
  INVITE_SENT            // Connect (data) + Connect-Msg (treść)  [OUTBOUND]
  INVITE_RECEIVED        // [INBOUND]
  INVITE_WITHDRAWN       // Withdraw: wycofałem zaproszenie po długim oczekiwaniu (może wrócić nowe INVITE_SENT)
  ACCEPTED               // Accept. Delay = Accept − Connect (liczone, nie zapisywane)
  REACTION_RECEIVED      // Appreciation: osoba przy akceptacji zareagowała (emotka, wiadomość)
  THANKS_SENT            // Appr.-Resp. (data) + Appr.-Resp.-Msg (moja wiadomość)
  ASKED_OPEN             // Are-You-Open (data) + A-Y-O-Text
  ASKED_OPEN_REMINDER    // A-Y-O-Reminder + A-Y-O-Reminder-Text
  ASKED_OPEN_RESPONSE    // A-Y-O-Response: data pierwszej reakcji na pytanie; decyzja może być od razu lub później
  OPEN_TO_TALK           // A-Y-O-Decision (data) gdy Open-To-Talk = TRUE
  NOT_INTERESTED         // A-Y-O-Decision (data) gdy NO = TRUE, + NO-Response-Text
  MEETING_PROPOSED       // Meet-Proposal + Meet-Proposal-Text
  MEETING_PROPOSAL_REMINDER // Meet-Proposal-Reminder + -Text
  BP_SCHEDULED           // BP-Date → scheduledAt
  BP_CONFIRMED           // Confirmed
  BP_CANCELED            // BP-Canceled
  BP_NO_SHOW             // BP-NoShow
  BP_COMPLETED           // BP-Completed
  DECISION_YES           // Decision-YES
  DECISION_NO            // Decision-NO
  VIEWED_MY_PROFILE      // Viewed / onViewersList / dane z content3.js
  NOTE
}

model ContactEvent {
  id          String    @id @default(cuid())
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type        EventType
  occurredAt  DateTime
  message     String?   // treść wysłanej / otrzymanej wiadomości
  scheduledAt DateTime? // np. termin BP
  dateUnknown Boolean   @default(false) // true = occurredAt to znacznik (np. 2000-01-01), nie prawdziwa data; pomijać w statystykach czasu
  createdAt   DateTime  @default(now())

  @@index([contactId, occurredAt])
  @@index([type, occurredAt])
}

// ───────────────────── Tagi (dawne zakładki-segmenty) ─────────────────────

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique // "Częstochowa", "Wrocław (nauczycielki)", "Katowice - reconnect"…
  contacts ContactTag[]
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

// ─────────── Surowe dane z rozszerzenia (dziś: li-contact-data-store) ───────────

model Capture {
  id         String   @id @default(cuid())
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source     Source
  payload    Json     // pojedynczy element "results" z webhooka, bez zmian
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// ───────────────────────── Czas pracy (dziś: li-time) ─────────────────────────

model ActivityType {
  id      String      @id @default(cuid())
  name    String      @unique // "akceptacja", "zaproszenia do kontaktu", "wiadomość", "oglądacze"…
  entries TimeEntry[]
}

model TimeEntry {
  id             String        @id @default(cuid())
  startedAt      DateTime
  endedAt        DateTime?     // null = sesja w toku (przycisk start/stop)
  activityTypeId String?
  activityType   ActivityType? @relation(fields: [activityTypeId], references: [id])
  count          Int?          // "akceptacja (3)" → 3
  note           String?

  @@index([startedAt])
}
